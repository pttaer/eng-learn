<?xml version="1.0" encoding="utf-8"?>
<!-- Offline shell: no INTERNET permission, so the app cannot reach the network at all. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.englishsingularity">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".SingularityWidgetProvider"
            android:label="@string/widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.englishsingularity.ACTION_NEXT_WORD" />
                <action android:name="app.englishsingularity.ACTION_SPEAK_WORD" />
                <action android:name="app.englishsingularity.ACTION_SPEAK_SENTENCE" />
                <action android:name="app.englishsingularity.ACTION_TOGGLE_RECALL" />
                <action android:name="app.englishsingularity.ACTION_SELECT_TAB" />
                <action android:name="app.englishsingularity.ACTION_ANSWER_QUIZ" />
                <action android:name="app.englishsingularity.ACTION_NEXT_QUIZ" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>

