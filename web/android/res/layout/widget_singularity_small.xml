<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Compact Top Bar: Flame Streak Pill + In-Place Next Trigger -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingLeft="8dp"
            android:paddingTop="3dp"
            android:paddingRight="8dp"
            android:paddingBottom="3dp"
            android:text="🔥 12d"
            android:textColor="@color/widget_accent_primary"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_action_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg"
            android:paddingLeft="10dp"
            android:paddingTop="3.5dp"
            android:paddingRight="10dp"
            android:paddingBottom="3.5dp"
            android:text="@string/widget_next_compact"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Compact Card Content: Word + Pronunciation Audio + Phonetics/Meaning -->
    <LinearLayout
        android:id="@+id/widget_card_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_word"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ephemeral"
                android:textColor="@color/widget_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_btn_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_btn_bg"
                android:paddingLeft="8dp"
                android:paddingTop="2.5dp"
                android:paddingRight="8dp"
                android:paddingBottom="2.5dp"
                android:text="🔊"
                android:textColor="@color/widget_accent_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_phonetic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="/ɪˈfem.ər.əl/ • adj"
            android:textColor="@color/widget_accent_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_meaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:text="Lasting for only a short period of time; fleeting."
            android:textColor="@color/widget_text_primary"
            android:textSize="11.5sp" />
    </LinearLayout>
</LinearLayout>
