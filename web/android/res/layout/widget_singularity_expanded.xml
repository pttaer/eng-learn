<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- File Explorer Folder Tabs Controller (Strictly Equal Weight) -->
    <LinearLayout
        android:id="@+id/widget_tab_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_tab_word"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_tab_active_bg"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/widget_tab_word"
            android:textColor="@color/widget_accent_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tab_quiz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_tab_inactive_bg"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/widget_tab_quiz"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tab_quests"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_tab_inactive_bg"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/widget_tab_quests"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tab_pillars"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_tab_inactive_bg"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/widget_tab_pillars"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- File Explorer Folder Body (ViewFlipper) -->
    <ViewFlipper
        android:id="@+id/widget_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_folder_body"
        android:padding="8dp"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out">

        <!-- TAB 1: 📖 Word Card -->
        <LinearLayout
            android:id="@+id/widget_tab1_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Subheader Bar: Streak + CEFR Tag + Next ↻ -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/widget_badge_bg"
                        android:paddingLeft="8dp"
                        android:paddingTop="2.5dp"
                        android:paddingRight="8dp"
                        android:paddingBottom="2.5dp"
                        android:text="🔥 12-Day Streak"
                        android:textColor="@color/widget_accent_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_badge_cefr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/widget_badge_bg"
                        android:letterSpacing="0.08"
                        android:paddingLeft="7dp"
                        android:paddingTop="2.5dp"
                        android:paddingRight="7dp"
                        android:paddingBottom="2.5dp"
                        android:text="@string/widget_cefr_tag"
                        android:textColor="@color/widget_accent_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_action_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/widget_btn_bg"
                    android:paddingLeft="9dp"
                    android:paddingTop="3dp"
                    android:paddingRight="9dp"
                    android:paddingBottom="3dp"
                    android:text="@string/widget_next"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Hero Word Row: Headword + Phonetics -->
            <LinearLayout
                android:id="@+id/widget_card_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="1dp">

                <TextView
                    android:id="@+id/widget_word"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ephemeral"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_phonetic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginStart="8dp"
                    android:text="/ɪˈfem.ər.əl/ • adj"
                    android:textColor="@color/widget_accent_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Dual Audio & Active Recall Utility Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_btn_audio_word"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_btn_bg"
                    android:paddingLeft="8dp"
                    android:paddingTop="3dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="3dp"
                    android:text="@string/widget_btn_audio_word"
                    android:textColor="@color/widget_accent_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_btn_audio_sentence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_btn_bg"
                    android:paddingLeft="8dp"
                    android:paddingTop="3dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="3dp"
                    android:text="@string/widget_btn_audio_sentence"
                    android:textColor="@color/widget_accent_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_btn_recall_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_btn_bg"
                    android:paddingLeft="8dp"
                    android:paddingTop="3dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="3dp"
                    android:text="@string/widget_btn_recall_hide"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Definition Block -->
            <TextView
                android:id="@+id/widget_label_def"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:letterSpacing="0.08"
                android:text="@string/widget_def_label"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_meaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Lasting for only a short period of time; fleeting or transient."
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp" />

            <!-- Example Sentence Block -->
            <TextView
                android:id="@+id/widget_label_example"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:letterSpacing="0.08"
                android:text="@string/widget_ex_label"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_example"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="“Fame in the digital era is intensely ephemeral, vanishing as swiftly as it emerges.”"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11.5sp"
                android:textStyle="italic" />

            <!-- Collocations & Synonyms Tag Block -->
            <LinearLayout
                android:id="@+id/widget_tags_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/widget_tag_bg"
                android:paddingLeft="8dp"
                android:paddingTop="3.5dp"
                android:paddingRight="8dp"
                android:paddingBottom="3.5dp">

                <TextView
                    android:id="@+id/widget_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Collocations: ephemeral nature, ephemeral pleasure  •  Synonyms: transient, fleeting"
                    android:textColor="@color/widget_accent_primary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- TAB 2: 🧠 Vocab Flash Quiz -->
        <LinearLayout
            android:id="@+id/widget_tab_quiz_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Subheader Bar: Quiz Score Pill + Level + Next Question ↻ -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_quiz_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/widget_badge_bg"
                        android:paddingLeft="8dp"
                        android:paddingTop="2.5dp"
                        android:paddingRight="8dp"
                        android:paddingBottom="2.5dp"
                        android:text="🧠 0 Đúng (+0 XP)"
                        android:textColor="@color/widget_accent_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_quiz_badge_cefr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/widget_badge_bg"
                        android:letterSpacing="0.08"
                        android:paddingLeft="7dp"
                        android:paddingTop="2.5dp"
                        android:paddingRight="7dp"
                        android:paddingBottom="2.5dp"
                        android:text="C2 QUIZ"
                        android:textColor="@color/widget_accent_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_quiz_action_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/widget_btn_bg"
                    android:paddingLeft="9dp"
                    android:paddingTop="3dp"
                    android:paddingRight="9dp"
                    android:paddingBottom="3dp"
                    android:text="@string/widget_quiz_next"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Question Prompt Box -->
            <TextView
                android:id="@+id/widget_quiz_prompt_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.08"
                android:text="@string/widget_quiz_prompt"
                android:textColor="@color/widget_text_muted"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_quiz_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Ephemeral"
                android:textColor="@color/widget_text_primary"
                android:textSize="17.5sp"
                android:textStyle="bold" />

            <!-- Options Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="vertical">

                <!-- Option A -->
                <RelativeLayout
                    android:id="@+id/widget_quiz_opt_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/widget_btn_bg"
                    android:paddingLeft="10dp"
                    android:paddingTop="5dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="5dp">

                    <TextView
                        android:id="@+id/widget_quiz_opt_text_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="A. Fleeting or transient"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11.5sp" />
                </RelativeLayout>

                <!-- Option B -->
                <RelativeLayout
                    android:id="@+id/widget_quiz_opt_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/widget_btn_bg"
                    android:paddingLeft="10dp"
                    android:paddingTop="5dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="5dp">

                    <TextView
                        android:id="@+id/widget_quiz_opt_text_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="B. Present everywhere"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11.5sp" />
                </RelativeLayout>

                <!-- Option C -->
                <RelativeLayout
                    android:id="@+id/widget_quiz_opt_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_btn_bg"
                    android:paddingLeft="10dp"
                    android:paddingTop="5dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="5dp">

                    <TextView
                        android:id="@+id/widget_quiz_opt_text_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="C. Make less severe"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11.5sp" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Instant Feedback Banner -->
            <TextView
                android:id="@+id/widget_quiz_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/widget_tag_bg"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingLeft="8dp"
                android:paddingTop="4dp"
                android:paddingRight="8dp"
                android:paddingBottom="4dp"
                android:text="@string/widget_quiz_hint"
                android:textColor="@color/widget_accent_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- TAB 3: 🎯 Quests -->
        <LinearLayout
            android:id="@+id/widget_tab2_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Streak & Level Banner -->
            <TextView
                android:id="@+id/widget_quest_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_bg"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="🔥 12-Day Streak • Lv.4 Explorer"
                android:textColor="@color/widget_accent_primary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <!-- Daily Goal Progress Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:letterSpacing="0.08"
                    android:text="@string/widget_quests_title"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_quest_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    android:text="2/3 Completed (67%)"
                    android:textColor="@color/widget_accent_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Horizontal Progress Bar -->
            <ProgressBar
                android:id="@+id/widget_quest_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginBottom="8dp"
                android:max="100"
                android:progress="67"
                android:progressDrawable="@drawable/widget_progress_bar" />

            <!-- Quest Checklist Items -->
            <!-- Quest Item 1: Completed -->
            <RelativeLayout
                android:id="@+id/widget_quest_item_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:background="@drawable/widget_btn_bg"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/widget_quest_title_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="✔  15 SRS Cards Reviewed"
                    android:textColor="@color/widget_accent_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_quest_status_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Done (+50 XP)"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="11sp" />
            </RelativeLayout>

            <!-- Quest Item 2: Pending -->
            <RelativeLayout
                android:id="@+id/widget_quest_item_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:background="@drawable/widget_btn_bg"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/widget_quest_title_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="○  1 Franklin Rhetorical Copywork"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/widget_quest_status_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Start →"
                    android:textColor="@color/widget_accent_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Quest Item 3: Pending -->
            <RelativeLayout
                android:id="@+id/widget_quest_item_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_btn_bg"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/widget_quest_title_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="○  1 Examiner Speaking Simulation"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/widget_quest_status_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Start →"
                    android:textColor="@color/widget_accent_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>

        <!-- TAB 3: ⚡ 4 Pillars -->
        <LinearLayout
            android:id="@+id/widget_tab3_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/widget_pillars_title"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Row 1: Reading & Writing Tiles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/widget_tile_reading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn_bg"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_pillar_reading"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/widget_reading_subtitle"
                        android:textColor="@color/widget_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_tile_writing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn_bg"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_pillar_writing"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/widget_writing_subtitle"
                        android:textColor="@color/widget_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Listening & Speaking Tiles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/widget_tile_listening"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn_bg"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_pillar_listening"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/widget_listening_subtitle"
                        android:textColor="@color/widget_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_tile_speaking"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn_bg"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_pillar_speaking"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/widget_speaking_subtitle"
                        android:textColor="@color/widget_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Full IELTS Academic Suite Launch Button -->
            <TextView
                android:id="@+id/widget_btn_launch_ielts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/widget_tab_active_bg"
                android:gravity="center"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="@string/widget_btn_launch_ielts"
                android:textColor="@color/widget_accent_primary"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ViewFlipper>

    <!-- Bottom Actions Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_kicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.08"
            android:text="ENGLISH SINGULARITY"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_vocab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="5dp"
            android:text="@string/widget_btn_study"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_ielts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_bg"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="5dp"
            android:text="@string/widget_btn_ielts"
            android:textColor="@color/widget_accent_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
