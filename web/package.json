{
  "name": "eng-singularity",
  "version": "1.0.0",
  "private": true,
  "description": "English Singularity - C2 Native English Mastery System",
  "author": "English Singularity Team",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "content:compile": "node scripts/compile-content.cjs",
    "content:watch": "node scripts/compile-content.cjs --watch",
    "test:content": "node scripts/verify-content-pipeline.cjs",
    "icons": "node scripts/generate-icons.cjs && node scripts/generate-ico.cjs",
    "prebuild": "node scripts/compile-content.cjs && node scripts/generate-icons.cjs && node scripts/generate-ico.cjs",
    "dev": "vite",
    "build": "node scripts/build.cjs",
    "build:fast": "vite build",
    "build:singularity": "node -e \"process.env.APP_TARGET='singularity'; require('child_process').execSync('vite build', {stdio:'inherit'})\"",
    "build:ielts": "node -e \"process.env.APP_TARGET='ielts'; require('child_process').execSync('vite build', {stdio:'inherit'})\"",
    "build:phone": "node scripts/build-phone.cjs",
    "build:apk": "node scripts/build-apk.cjs",
    "build:apk:ielts": "node scripts/build-apk.cjs --app=ielts",
    "preview": "vite preview",
    "electron:start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "test": "tsc --noEmit && node scripts/run-verify.cjs",
    "test:boundaries": "node scripts/verify-decoupling-integrity.cjs",
    "test:workout": "node scripts/verify-daily-workout.cjs",
    "test:mobile": "node scripts/verify-mobile-touch-qa.cjs",
    "test:installer": "node scripts/verify-installer-artifact.cjs",
    "undraw": "node C:/Users/thanh/.gemini/config/skills/undraw/scripts/undraw.cjs"
  },
  "dependencies": {
    "animejs": "^4.5.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "build": {
    "appId": "com.english.singularity",
    "productName": "English Singularity",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icon.ico",
      "public/icon-512.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "English Singularity",
      "uninstallDisplayName": "English Singularity",
      "runAfterFinish": true
    }
  }
}